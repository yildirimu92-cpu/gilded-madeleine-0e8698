---
import Wordmark from '../components/Wordmark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

const year = new Date().getFullYear();
---

<BaseLayout title={t('home.title')} description={t('home.description')}>
  <header slot="header" class="bar">
    <Wordmark href="/" />
  </header>

  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1 id="intro-title">{t('home.heading')}</h1>
    <p class="lead">{t('home.lead')}</p>
  </section>

  <footer slot="footer" class="bar bar--footer">
    <small>{t('footer.copyright').replace('{year}', String(year))}</small>
  </footer>
</BaseLayout>

<style>
  .bar {
    width: min(72rem, 100% - 2rem);
    margin-inline: auto;
    padding-block: 1.5rem;
  }

  .bar--footer {
    color: var(--color-ink-muted);
  }

  .intro {
    width: min(72rem, 100% - 2rem);
    margin-inline: auto;
    padding-block: clamp(4rem, 14vw, 9rem);
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: #e3f6ee;
    font-size: 0.875rem;
    font-weight: 600;
  }

  h1 {
    max-width: 18ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 1.4rem + 4.2vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .lead {
    max-width: 38rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
  }
</style>
