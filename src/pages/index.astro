---
import PublicLayout from '../layouts/PublicLayout.astro';
import { t } from '../i18n/ui';
---

<PublicLayout title={t('home.title')} description={t('home.description')}>
  <section class="container intro" aria-labelledby="intro-title">
    <div class="stack">
      <p class="eyebrow text-label">{t('home.eyebrow')}</p>
      <h1 id="intro-title" class="text-display">
        {t('home.heading')}
      </h1>
      <p class="text-lead">{t('home.lead')}</p>
    </div>
  </section>
</PublicLayout>

<style>
  .intro {
    padding-block: var(--section-y);
  }

  .intro h1 {
    max-width: 16ch;
    margin-block: var(--space-2) var(--space-2);
  }

  .eyebrow {
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-accent);
    color: var(--color-text-on-accent);
  }
</style>
