---
import Logo from '../components/brand/Logo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

const year = new Date().getFullYear();
---

<BaseLayout title={t('home.title')} description={t('home.description')}>
  <header slot="header" class="container bar">
    <Logo href="/" />
  </header>

  <section class="container intro" aria-labelledby="intro-title">
    <div class="stack">
      <p class="eyebrow text-label">{t('home.eyebrow')}</p>
      <h1 id="intro-title" class="text-display">
        {t('home.heading')}
      </h1>
      <p class="text-lead">{t('home.lead')}</p>
    </div>
  </section>

  <footer slot="footer" class="container bar">
    <small>{t('footer.copyright').replace('{year}', String(year))}</small>
  </footer>
</BaseLayout>

<style>
  .bar {
    padding-block: var(--space-6);
  }

  .bar small {
    color: var(--color-text-muted);
  }

  .intro {
    padding-block: var(--section-y);
  }

  .intro h1 {
    max-width: 16ch;
    margin-block: var(--space-2) var(--space-2);
  }

  .eyebrow {
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-accent);
    color: var(--color-text-on-accent);
  }
</style>
