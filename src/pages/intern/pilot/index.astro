---
import PilotLeadForm from '../../../components/marketing/PilotLeadForm.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pilotformular – Designvorschau (intern)"
  description="Nicht aktive Vorschau der IzyOrder-Pilotanfrage."
  noindex
>
  <section class="container container--md preview" aria-labelledby="preview-heading">
    <p class="text-overline">Interne Designvorschau · nicht geschützt</p>
    <h1 id="preview-heading">Pilotanfrage testen.</h1>
    <p class="text-lead">
      Formular und Layout sind vorbereitet. Diese Vorschau sendet nichts, speichert nichts und
      enthält keine produktive Verbindung zu Netlify Forms oder einem CRM.
    </p>
    <p class="preview__warning">
      Bitte keine echten Personen- oder Kundendaten eingeben. Die Seite ist per URL erreichbar, auch
      wenn sie nicht in Suchmaschinen erscheinen soll.
    </p>
    <PilotLeadForm mode="preview" />
  </section>
</BaseLayout>

<style>
  .preview {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--section-y-sm) var(--section-y);
  }

  .preview__warning {
    padding: var(--space-5);
    border: 1px solid var(--color-warning-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-warning-bg);
    color: var(--color-warning);
    font-size: var(--text-body-sm);
  }
</style>
