---
/**
 * Zielgruppen-Landingpage für Takeaways (Schweiz), vor Launch bewusst noindex.
 * Keine erfundenen Kunden, Referenzen, Live-Funktionen oder verbindlichen Tarife.
 * Leads werden auf dieser Seite nicht erhoben.
 */
import Button from '../../components/ui/Button.astro';
import { legalNavigation, pilotCta } from '../../config/navigation';
import Section from '../../components/ui/Section.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';

const pilotAction = pilotCta(
  process.env,
  legalNavigation.some((item) => item.id === 'datenschutz' && item.status === 'live'),
);

const challenges = [
  {
    index: '01',
    title: 'Wiederkehrende Gäste direkt erreichen',
    copy: 'Eine eigene Bestelladresse kann helfen, dass Gäste beim nächsten Mal direkt bei Ihrem Betrieb bestellen – statt erst eine Plattform öffnen zu müssen.',
  },
  {
    index: '02',
    title: 'Mittags- und Abendgeschäft abbilden',
    copy: 'Pausen zwischen den Services, Abholzeiten und Lieferfenster gehören zu den typischen Anforderungen, für die wir die Lösung entwickeln.',
  },
  {
    index: '03',
    title: 'Bestellabläufe übersichtlich halten',
    copy: 'Speisekarte, Zusatzoptionen und Bestellübersicht sollen so aufgebaut sein, dass sie auch bei Betriebsspitzen gut bedienbar bleiben.',
  },
] as const;

const steps = [
  {
    number: '01',
    title: 'Speisekarte vorbereiten',
    copy: 'Gerichte, Kategorien und Optionen für den eigenen digitalen Bestellkanal erfassen.',
  },
  {
    number: '02',
    title: 'Abholung und Lieferung einrichten',
    copy: 'Bestellarten, Liefergebiet und passende Öffnungszeiten für Ihren Betrieb bestimmen.',
  },
  {
    number: '03',
    title: 'Direktbestellungen bearbeiten',
    copy: 'Gäste bestellen über Ihren Shop, Ihr Team bearbeitet die Aufträge im vorgesehenen Ablauf.',
  },
] as const;

const questions = [
  {
    question: 'Muss ich bestehende Lieferplattformen kündigen?',
    answer:
      'Nein. Ein eigener Bestellkanal kann als zusätzliche Möglichkeit für wiederkehrende Gäste aufgebaut werden. Eine automatische Verbindung zu Just Eat oder Uber Eats ist noch keine freigegebene Funktion.',
  },
  {
    question: 'Fallen bei IzyOrder wirklich keine Gebühren pro Bestellung an?',
    answer:
      'Das geplante Modell sieht 0 % IzyOrder-Plattformprovision auf Direktbestellungen vor. Software-Abonnement, allfällige Einrichtungsleistungen und Gebühren externer Zahlungsanbieter sind davon unabhängig.',
  },
  {
    question: 'Kann ich eine Mittagspause und Abendöffnungszeiten einstellen?',
    answer:
      'Geteilte Öffnungszeiten für Mittags- und Abendservice gehören zu den vorgesehenen Einstellmöglichkeiten. Die konkrete Produktverfügbarkeit wird vor dem Marktstart geprüft.',
  },
  {
    question: 'Ist das Bestellsystem schon erhältlich?',
    answer:
      'Noch nicht. IzyOrder befindet sich in Entwicklung. Ein freigegebener Demo-Zugang und die Möglichkeit zur Pilotanfrage folgen nach technischer und rechtlicher Prüfung.',
  },
] as const;
---

<PublicLayout
  title="Online-Bestellsystem für Takeaways in der Schweiz – IzyOrder"
  description="IzyOrder entwickelt einen eigenen Online-Bestellshop für Schweizer Takeaways: Direktbestellungen, Abholung, Lieferung und 0 % geplante Plattformprovision. Noch in Entwicklung."
  noindex
>
  <section class="takeaway-hero" aria-labelledby="takeaway-heading">
    <div class="container container--xl takeaway-hero__grid">
      <div class="takeaway-hero__copy">
        <p class="takeaway-overline">Für Takeaways und Lieferbetriebe · Schweiz</p>
        <h1 id="takeaway-heading" class="text-display">
          Ihr Takeaway.<span>Ihr Bestellkanal.</span>
        </h1>
        <p class="text-lead">
          Stammgäste sollen direkt bei Ihrem Betrieb bestellen können – für Abholung und Lieferung.
          IzyOrder wird als unabhängiger Online-Bestellshop für die Schweizer Gastronomie
          entwickelt.
        </p>
        <div class="takeaway-hero__actions">
          <Button href="#vorteile" size="lg" iconEnd="arrow-right">
            Konzept entdecken
          </Button>
          <Button href="/provisionsrechner/" size="lg" variant="secondary">
            Kostenbeispiel berechnen
          </Button>
        </div>
        <p class="takeaway-hero__status">
          In Entwicklung. Noch kein buchbares Angebot und keine freigegebene Live-Demo.
        </p>
      </div>

      <div
        class="takeaway-concept"
        aria-label="Schematische Darstellung eines digitalen Direktbestellablaufs"
      >
        <div class="takeaway-concept__top">
          <span>IZYORDER / KONZEPT</span>
          <span>01 — 03</span>
        </div>
        <div class="takeaway-concept__inner">
          <div class="takeaway-concept__header">
            <span class="takeaway-concept__glyph" aria-hidden="true">
              IO
            </span>
            <div>
              <span>Ihr Takeaway</span>
              <strong>Direkt bestellen.</strong>
            </div>
          </div>
          <div class="takeaway-concept__choice" aria-label="Vorgesehene Bestellarten">
            <span>Abholung</span>
            <span>Lieferung</span>
          </div>
          <div class="takeaway-concept__flow" aria-label="Konzeptioneller Ablauf">
            <div>
              <span>01</span>
              <strong>Speisekarte auswählen</strong>
              <span aria-hidden="true">↗</span>
            </div>
            <div>
              <span>02</span>
              <strong>Bestellung aufgeben</strong>
              <span aria-hidden="true">↗</span>
            </div>
            <div>
              <span>03</span>
              <strong>Im Betrieb bearbeiten</strong>
              <span aria-hidden="true">✓</span>
            </div>
          </div>
        </div>
        <p class="takeaway-concept__caption">
          Schematische Konzeptillustration – keine produktive Shop-Oberfläche.
        </p>
      </div>
    </div>
  </section>

  <section class="takeaway-metrics" aria-label="Die Grundidee von IzyOrder">
    <div class="container container--xl takeaway-metrics__grid">
      <div>
        <strong>0 %</strong>
        <span>geplante Plattformprovision auf Direktbestellungen*</span>
      </div>
      <div>
        <strong>2</strong>
        <span>geplante Bestellarten: Abholung und Lieferung</span>
      </div>
      <div>
        <strong>1</strong>
        <span>eigener Online-Bestellkanal als Konzept</span>
      </div>
    </div>
    <p class="container container--xl takeaway-metrics__note">
      *Das geplante SaaS-Abonnement und Gebühren externer Zahlungsanbieter sind separat. Der
      Leistungsumfang ist noch nicht freigegeben.
    </p>
  </section>

  <Section id="vorteile" tone="subtle" size="xl" labelledby="takeaway-benefits-heading">
    <div class="takeaway-heading">
      <p class="takeaway-overline">Für den echten Takeaway-Alltag</p>
      <h2 id="takeaway-benefits-heading">
        Nicht noch eine Plattform. Ein direkter Weg zu Ihren Gästen.
      </h2>
      <p class="text-lead">
        Ein Bestellshop ist nur dann wertvoll, wenn er zu Ihrem Betrieb passt und Gäste ihn
        tatsächlich nutzen. Diese drei Herausforderungen stehen bei der Entwicklung im Mittelpunkt.
      </p>
    </div>
    <div class="takeaway-cards">
      {challenges.map((challenge) => (
        <article class="takeaway-card">
          <span class="takeaway-card__index" aria-hidden="true">
            {challenge.index}
          </span>
          <h3>{challenge.title}</h3>
          <p>{challenge.copy}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section size="xl" labelledby="takeaway-how-heading">
    <div class="takeaway-split">
      <div class="takeaway-heading">
        <p class="takeaway-overline">Einfach gedacht</p>
        <h2 id="takeaway-how-heading">Vom Menü zur Bestellung. Ohne unnötige Umwege.</h2>
        <p class="text-lead">
          Die folgende Darstellung beschreibt den geplanten Prozess. Ein konkreter Live-Betrieb wird
          erst nach vollständiger technischer Abnahme ermöglicht.
        </p>
        <Button href="/funktionen/" variant="secondary" iconEnd="arrow-right">
          Alle Funktionen ansehen
        </Button>
      </div>
      <ol class="takeaway-steps">
        {steps.map((step) => (
          <li>
            <span class="takeaway-steps__number" aria-hidden="true">
              {step.number}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section tone="inverse" size="lg" labelledby="takeaway-economic-heading">
    <div class="takeaway-economics">
      <div class="takeaway-economics__copy">
        <p class="takeaway-overline">Das Geschäftsmodell</p>
        <h2 id="takeaway-economic-heading">
          Weniger Abhängigkeit beginnt mit einem eigenen Kanal.
        </h2>
        <p>
          IzyOrder soll feste Softwaretarife statt einer prozentualen Plattformprovision auf
          Direktbestellungen verwenden. Ein eigener Shop ersetzt aber nicht automatisch die
          Reichweite eines Marktplatzes – Gäste müssen Ihren Bestellkanal zuerst kennenlernen.
        </p>
        <p>
          Nutzen Sie den Rechner, um verschiedene Annahmen zu Bestellvolumen und Kosten
          durchzuspielen. Er zeigt Szenarien, keine garantierten Einsparungen.
        </p>
        <Button href="/provisionsrechner/" size="lg" variant="secondary" iconEnd="arrow-right">
          Unverbindliches Kostenbeispiel
        </Button>
      </div>
      <div class="takeaway-economics__figure">
        <span>Geplantes Modell</span>
        <strong>0 %</strong>
        <p>Plattformprovision</p>
        <small>Abonnement und Zahlungsabwicklung nicht inklusive.</small>
      </div>
    </div>
  </Section>

  <Section id="fragen" tone="subtle" size="lg" labelledby="takeaway-faq-heading">
    <div class="takeaway-faq">
      <div class="takeaway-heading">
        <p class="takeaway-overline">Antworten für Inhaber</p>
        <h2 id="takeaway-faq-heading">Wichtige Fragen, bevor Sie entscheiden.</h2>
        <p>
          Transparent zum aktuellen Entwicklungsstand – ohne erfundene Kundenstimmen oder
          zugesicherte Resultate.
        </p>
      </div>
      <div class="takeaway-faq__items">
        {questions.map((item) => (
          <details>
            <summary>
              {item.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Section>

  <section class="takeaway-closing" aria-labelledby="takeaway-next-heading">
    <div class="container container--xl takeaway-closing__inner">
      <p class="takeaway-overline">IzyOrder für Schweizer Takeaways</p>
      <h2 id="takeaway-next-heading">Mehr Direktbestellungen. Auf Ihrem eigenen Weg.</h2>
      <p>
        {pilotAction
          ? 'Die Produktentwicklung läuft. Sie können jetzt unverbindlich Ihr Interesse an der Pilotphase anmelden.'
          : 'Die Produktentwicklung läuft. Bis Demo und Pilotanfragen freigegeben sind, können Sie unser Konzept und die geplanten Funktionen kennenlernen.'}
      </p>
      {pilotAction && (
        <Button href={pilotAction.href} size="lg" iconEnd="arrow-right">
          {pilotAction.label}
        </Button>
      )}
      <Button
        href="/funktionen/"
        size="lg"
        variant={pilotAction ? 'secondary' : 'primary'}
        iconEnd="arrow-right"
      >
        Bestellkonzept ansehen
      </Button>
    </div>
  </section>
</PublicLayout>

<style>
  .takeaway-overline {
    color: var(--color-text-accent);
    font-size: var(--text-overline);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
  }
  .takeaway-hero {
    overflow: hidden;
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }
  .takeaway-hero__grid {
    display: grid;
    align-items: center;
    gap: var(--space-12);
  }
  .takeaway-hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }
  .takeaway-hero h1 {
    max-width: 14ch;
    text-wrap: balance;
  }
  .takeaway-hero h1 span {
    display: block;
    color: var(--color-text-accent);
  }
  .takeaway-hero__copy > .text-lead {
    max-width: var(--measure-lead);
  }
  .takeaway-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .takeaway-hero__status {
    max-width: 55ch;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .takeaway-concept {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .takeaway-concept__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-overline);
  }
  .takeaway-concept__inner {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-bg-subtle);
  }
  .takeaway-concept__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .takeaway-concept__glyph {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.05em;
  }
  .takeaway-concept__header > div {
    display: grid;
    gap: var(--space-1);
  }
  .takeaway-concept__header > div > span {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .takeaway-concept__header strong {
    font-size: var(--text-h5);
  }
  .takeaway-concept__choice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .takeaway-concept__choice span {
    padding: var(--space-3) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
    font-size: var(--text-label);
    font-weight: var(--font-weight-semibold);
  }
  .takeaway-concept__flow {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .takeaway-concept__flow > div {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 4rem;
    padding-inline: var(--space-4);
  }
  .takeaway-concept__flow > div + div {
    border-top: 1px solid var(--color-border);
  }
  .takeaway-concept__flow > div > span {
    color: var(--color-text-accent);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
  }
  .takeaway-concept__flow > div > strong {
    flex: 1;
    min-width: 0;
    font-size: var(--text-body-sm);
  }
  .takeaway-concept__caption {
    padding: var(--space-4) var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .takeaway-metrics {
    padding-block: var(--space-8);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .takeaway-metrics__grid {
    display: grid;
    gap: var(--space-6);
  }
  .takeaway-metrics__grid > div {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border-strong);
  }
  .takeaway-metrics__grid strong {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
  }
  .takeaway-metrics__grid span,
  .takeaway-metrics__note {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .takeaway-metrics__note {
    margin-top: var(--space-6);
  }
  .takeaway-heading {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-5);
    max-width: var(--container-md);
    margin-bottom: var(--space-12);
  }
  .takeaway-heading h2 {
    max-width: 22ch;
  }
  .takeaway-heading > p:not(.takeaway-overline) {
    color: var(--color-text-muted);
  }
  .takeaway-cards {
    display: grid;
    gap: var(--grid-gap);
  }
  .takeaway-card {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    min-width: 0;
    padding: clamp(1.5rem, 2.8vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }
  .takeaway-card__index {
    color: var(--color-text-accent);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
  }
  .takeaway-card h3 {
    max-width: 17ch;
    font-size: var(--text-h4);
  }
  .takeaway-card p,
  .takeaway-steps p {
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
  }
  .takeaway-split {
    display: grid;
    align-items: start;
    gap: var(--space-10);
  }
  .takeaway-split .takeaway-heading {
    margin-bottom: 0;
  }
  .takeaway-steps {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .takeaway-steps li {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
  }
  .takeaway-steps__number {
    color: var(--color-text-accent);
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
  }
  .takeaway-steps li > div {
    display: grid;
    gap: var(--space-3);
  }
  .takeaway-steps h3 {
    font-size: var(--text-h5);
  }
  .takeaway-economics {
    display: grid;
    align-items: center;
    gap: var(--space-10);
  }
  .takeaway-economics__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }
  .takeaway-economics__copy h2 {
    max-width: 23ch;
  }
  .takeaway-economics__copy p:not(.takeaway-overline) {
    color: var(--color-text-muted);
  }
  .takeaway-economics__figure {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .takeaway-economics__figure > span,
  .takeaway-economics__figure > small {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .takeaway-economics__figure strong {
    font-size: clamp(4.5rem, 8vw, 7rem);
    line-height: 1;
    letter-spacing: -0.07em;
    color: var(--color-text-accent);
  }
  .takeaway-economics__figure p {
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-semibold);
  }
  .takeaway-faq {
    display: grid;
    gap: var(--space-8);
  }
  .takeaway-faq .takeaway-heading {
    margin-bottom: 0;
  }
  .takeaway-faq__items {
    display: grid;
    gap: var(--space-2);
  }
  .takeaway-faq__items details {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .takeaway-faq__items summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .takeaway-faq__items summary > span {
    color: var(--color-text-accent);
    font-size: var(--text-h5);
  }
  .takeaway-faq__items details[open] summary > span {
    transform: rotate(45deg);
  }
  .takeaway-faq__items details > p {
    padding-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
  }
  .takeaway-closing {
    padding-block: var(--section-y);
  }
  .takeaway-closing__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }
  .takeaway-closing__inner h2 {
    max-width: 23ch;
  }
  .takeaway-closing__inner > p:not(.takeaway-overline) {
    max-width: 65ch;
    color: var(--color-text-muted);
  }
  @media (min-width: 768px) {
    .takeaway-metrics__grid,
    .takeaway-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .takeaway-hero__grid,
    .takeaway-economics {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .takeaway-split,
    .takeaway-faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
