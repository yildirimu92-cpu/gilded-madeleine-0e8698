---
import Wordmark from '../components/Wordmark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
---

<BaseLayout title={`${t('notFound.title')} – IzyOrder`} description={t('notFound.text')} noindex>
  <section class="not-found" aria-labelledby="nf-title">
    <Wordmark href="/" />
    <h1 id="nf-title">{t('notFound.title')}</h1>
    <p>{t('notFound.text')}</p>
    <a class="back" href="/">
      {t('notFound.back')}
    </a>
  </section>
</BaseLayout>

<style>
  .not-found {
    width: min(40rem, 100% - 2rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 12vw, 8rem);
  }

  h1 {
    margin: 2.5rem 0 0.75rem;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  p {
    color: var(--color-ink-muted);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }
</style>
