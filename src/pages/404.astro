---
import Button from '../components/ui/Button.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { t } from '../i18n/ui';
---

<PublicLayout title={t('notFound.title')} description={t('notFound.text')} noindex>
  <section class="container container--prose section" aria-labelledby="nf-title">
    <div class="stack stack--lg">
      <div class="stack">
        <p class="text-overline">404</p>
        <h1 id="nf-title">{t('notFound.title')}</h1>
        <p class="text-lead">{t('notFound.text')}</p>
      </div>
      <div>
        <Button href="/" iconEnd="arrow-right">
          {t('notFound.back')}
        </Button>
      </div>
    </div>
  </section>
</PublicLayout>
