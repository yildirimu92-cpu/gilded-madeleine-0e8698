---
import Logo from '../components/brand/Logo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
---

<BaseLayout title={`${t('notFound.title')} – IzyOrder`} description={t('notFound.text')} noindex>
  <section class="container container--prose section" aria-labelledby="nf-title">
    <div class="stack stack--lg">
      <Logo href="/" />
      <div class="stack">
        <h1 id="nf-title">{t('notFound.title')}</h1>
        <p class="text-lead">{t('notFound.text')}</p>
      </div>
      <a class="back" href="/">
        {t('notFound.back')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-action);
    color: var(--color-action-text);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .back:hover {
    background: var(--color-action-hover);
    color: var(--color-action-text);
  }

  .back:active {
    background: var(--color-action-active);
    transform: translateY(1px);
  }
</style>
