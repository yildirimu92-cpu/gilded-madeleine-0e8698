---
/**
 * SEO-Kopfdaten (erweitert in PR #5).
 * - Titel (mit Marke), Description, Canonical, robots
 * - hreflang-Alternativen aktiver Sprachen + x-default
 * - Open Graph und Twitter/X (ohne Bild, bis das finale Motiv freigegeben ist)
 * - JSON-LD (WebSite, Organization nur mit Marke/URL/Claim, WebPage)
 * Erzwungenes `noindex` (404, interne Seiten): kein Canonical, keine Alternativen, kein JSON-LD.
 */
import { locales, type Locale } from '../i18n/config';
import { alternateLinks, canonicalUrl, fullTitle, jsonLd, serializeJsonLd } from '../lib/seo';
import { isIndexable, ROBOTS_NOINDEX } from '../lib/site-config';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Erzwingt noindex unabhängig von der Umgebung (z. B. 404, interne Seiten). */
  noindex?: boolean;
  /** Open-Graph-Typ, Standard «website» */
  type?: 'website' | 'article';
}

const { title, description, locale, noindex = false, type = 'website' } = Astro.props;
const site = Astro.site?.href ?? Astro.url.origin;
const indexable = isIndexable(process.env) && !noindex;
const pageTitle = fullTitle(title);
const canonical = canonicalUrl(Astro.url.pathname, site);
const prefix = locales[locale].prefix;
const pathWithoutLocale =
  prefix && Astro.url.pathname.startsWith(prefix)
    ? Astro.url.pathname.slice(prefix.length) || '/'
    : Astro.url.pathname;
const alternates = noindex ? [] : alternateLinks(pathWithoutLocale, site);
const structured = noindex
  ? null
  : serializeJsonLd(jsonLd(site, { title: pageTitle, description, url: canonical, locale }));
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={indexable ? 'index, follow' : ROBOTS_NOINDEX} />
{!noindex && <link rel="canonical" href={canonical} />}
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="IzyOrder" />
<meta property="og:locale" content={locales[locale].ogLocale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{structured && <script type="application/ld+json" is:inline set:html={structured} />}
