---
/**
 * Modaler Dialog auf Basis von <dialog> (Fokus-Isolation und Escape nativ).
 * Öffnen: beliebiges Element mit data-dialog-open="<id>" (z. B. <Button>).
 * Slots: default (Inhalt) · footer (Aktionen; Buttons mit data-dialog-close schliessen).
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  size?: 'sm' | 'md';
  /** Schliessen per Klick auf den Hintergrund erlauben */
  dismissible?: boolean;
  closeLabel?: string;
}

const {
  id,
  title,
  description,
  size = 'md',
  dismissible = true,
  closeLabel = 'Dialog schliessen',
} = Astro.props;
---

<dialog
  class:list={['dialog', `dialog--${size}`]}
  id={id}
  aria-labelledby={`${id}-title`}
  aria-describedby={description ? `${id}-desc` : undefined}
  data-dismissible={dismissible ? undefined : 'false'}
>
  <div class="dialog__panel">
    <header class="dialog__header">
      <h2 class="dialog__title" id={`${id}-title`}>
        {title}
      </h2>
      <button type="button" class="dialog__close" data-dialog-close aria-label={closeLabel}>
        <Icon name="close" size={20} />
      </button>
    </header>
    {description && (
      <p class="dialog__description" id={`${id}-desc`}>
        {description}
      </p>
    )}
    <div class="dialog__body">
      <slot />
    </div>
    {Astro.slots.has('footer') && (
      <footer class="dialog__footer">
        <slot name="footer" />
      </footer>
    )}
  </div>
</dialog>

<script>
  import '../../scripts/dialog';
</script>

<style>
  .dialog {
    width: min(100% - 2 * var(--space-4), var(--dialog-width-md));
    max-width: none;
    max-height: min(100dvh - 2 * var(--space-6), 48rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
  }

  .dialog--sm {
    width: min(100% - 2 * var(--space-4), var(--dialog-width-sm));
  }

  .dialog::backdrop {
    background-color: var(--color-overlay);
  }

  .dialog[open] {
    animation: dialog-in var(--duration-base) var(--ease-out);
  }

  .dialog[open]::backdrop {
    animation: backdrop-in var(--duration-base) var(--ease-out);
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  .dialog__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  @media (min-width: 768px) {
    .dialog__panel {
      padding: var(--space-8);
    }
  }

  .dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .dialog__title {
    font-size: var(--text-h4);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-h4);
  }

  .dialog__close {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    margin: calc(var(--space-2) * -1) calc(var(--space-2) * -1) 0 0;
    border: 0;
    border-radius: var(--control-radius);
    background: transparent;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .dialog__close:hover {
    background-color: var(--color-action-secondary-hover);
    color: var(--color-text);
  }

  .dialog__description {
    margin-top: calc(var(--space-2) * -1);
    color: var(--color-text-muted);
  }

  .dialog__body {
    min-width: 0;
  }

  .dialog__footer {
    display: flex;
    flex-wrap: wrap-reverse;
    justify-content: flex-end;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  @media (max-width: 479px) {
    .dialog__footer > :global(*) {
      flex: 1 1 100%;
    }
  }

  :global(html.has-dialog) {
    overflow: hidden;
  }
</style>
