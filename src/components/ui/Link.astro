---
/**
 * Link für interne und externe Navigation.
 * - extern (automatisch erkannt): Icon ↗, rel="noopener noreferrer", Hinweis für Screenreader
 * - `current`: aktive Seite (aria-current="page")
 * - Varianten: inline (im Fliesstext) · standalone (eigenständig, mit Pfeil, Touch-Ziel 44 px)
 */
import type { HTMLAttributes } from 'astro/types';
import { externalRel, isExternalHref } from '../../lib/links';
import Icon from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: 'inline' | 'standalone' | 'nav';
  external?: boolean;
  newTab?: boolean;
  current?: boolean;
  class?: string;
}

const {
  href,
  variant = 'inline',
  external,
  newTab,
  current = false,
  class: className,
  ...rest
} = Astro.props;

const isExternal = external ?? isExternalHref(href, Astro.site?.origin);
const openInNewTab = newTab ?? isExternal;
---

<a
  class:list={['link', `link--${variant}`, { 'is-current': current }, className]}
  href={href}
  target={openInNewTab ? '_blank' : undefined}
  rel={isExternal ? externalRel(openInNewTab) : undefined}
  aria-current={current ? 'page' : undefined}
  {...rest}
>
  <slot />
  {isExternal ? (
    <>
      <Icon name="arrow-up-right" size={16} class="link__icon" />
      <span class="visually-hidden">
        {openInNewTab ? ' (externer Link, öffnet in neuem Tab)' : ' (externer Link)'}
      </span>
    </>
  ) : (
    variant === 'standalone' && (
      <Icon name="arrow-right" size={18} class="link__icon link__icon--move" />
    )
  )}
</a>

<style>
  .link {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    border-radius: 2px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .link:hover {
    color: var(--color-link-hover);
    text-decoration-color: currentColor;
  }

  .link__icon {
    display: inline-block;
    margin-inline-start: 0.15em;
    vertical-align: -0.12em;
  }

  .link--standalone,
  .link--nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .link--standalone:hover {
    text-decoration-line: underline;
  }

  .link--standalone :global(.link__icon--move) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .link--standalone:hover :global(.link__icon--move) {
    transform: translateX(3px);
  }

  .link--nav {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
    padding-inline: var(--space-1);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
  }

  .link--nav:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }

  .link--nav.is-current {
    text-decoration-color: var(--color-link);
  }
</style>
