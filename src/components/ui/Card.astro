---
/**
 * Karte – Grundlage für Feature-, Preis- und Inhaltskarten.
 * variant: neutral · interactive (ganze Karte klickbar via `href`) · featured (hervorgehoben)
 * Slots: media · eyebrow · default (Inhalt) · footer
 */
interface Props {
  variant?: 'neutral' | 'interactive' | 'featured';
  title?: string;
  titleTag?: 'h2' | 'h3' | 'h4';
  href?: string;
  padding?: 'md' | 'lg';
  as?: 'article' | 'div' | 'li';
  class?: string;
}

const {
  variant = 'neutral',
  title,
  titleTag: Heading = 'h3',
  href,
  padding = 'md',
  as: Tag = 'article',
  class: className,
} = Astro.props;

if (variant === 'interactive' && !href) {
  throw new Error('Card variant="interactive" benötigt `href`.');
}
const hasMedia = Astro.slots.has('media');
---

<Tag class:list={['card', `card--${variant}`, `card--pad-${padding}`, className]}>
  {hasMedia && (
    <div class="card__media">
      <slot name="media" />
    </div>
  )}
  <div class="card__body">
    {Astro.slots.has('eyebrow') && (
      <div class="card__eyebrow">
        <slot name="eyebrow" />
      </div>
    )}
    {title && (
      <Heading class="card__title">
        {href ? (
          <a class="card__link" href={href}>
            {title}
          </a>
        ) : (
          title
        )}
      </Heading>
    )}
    <div class="card__content">
      <slot />
    </div>
    {Astro.slots.has('footer') && (
      <div class="card__footer">
        <slot name="footer" />
      </div>
    )}
  </div>
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .card__media :global(img),
  .card__media :global(svg) {
    width: 100%;
    height: auto;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--card-padding);
  }

  .card--pad-lg .card__body {
    padding: calc(var(--card-padding) * 1.35);
  }

  .card__title {
    font-size: var(--text-h5);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-h4);
  }

  .card__content {
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
  }

  .card__content :global(p) {
    max-width: none;
  }

  .card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* Interaktiv: ganze Fläche klickbar (Stretched Link), Fokus auf der Karte sichtbar */
  .card__link {
    color: inherit;
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card--interactive {
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .card--interactive:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card--interactive:hover .card__title {
    color: var(--color-link);
  }

  .card--interactive:has(.card__link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .card--interactive:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  /* Weitere Links/Buttons in interaktiven Karten liegen über dem Stretched Link */
  .card--interactive .card__footer :global(a),
  .card--interactive .card__footer :global(button) {
    position: relative;
    z-index: 2;
  }

  /* Hervorgehoben */
  .card--featured {
    border-color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  .card--featured::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background-color: var(--color-accent);
  }
</style>
