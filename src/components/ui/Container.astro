---
/** Begrenzt die Inhaltsbreite und setzt den fluiden Seitenrand. */
import type { HTMLTag } from 'astro/types';

interface Props {
  size?: 'prose' | 'md' | 'lg' | 'xl';
  as?: HTMLTag;
  class?: string;
}

const { size = 'lg', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', { [`container--${size}`]: size !== 'lg' }, className]}>
  <slot />
</Tag>
