---
/**
 * Übergangs-Wortmarke (ADR 0008). Einzige Stelle, an der die Marke dargestellt wird –
 * das finale Logo ersetzt nur diese Komponente.
 */
interface Props {
  href?: string;
  size?: 'md' | 'lg';
}

const { href, size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['wordmark', `wordmark--${size}`]}
  href={href}
  aria-label={href ? 'IzyOrder – Startseite' : undefined}
>
  <span class="wordmark__text">IzyOrder</span>
  <span class="wordmark__dot" aria-hidden="true"></span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .wordmark--md {
    font-size: 1.5rem;
  }

  .wordmark--lg {
    font-size: 2rem;
  }

  .wordmark__dot {
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.06em var(--color-ink);
  }
</style>
