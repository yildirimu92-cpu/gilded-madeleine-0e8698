{
  "name": "izyorder-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "IzyOrder – Marketing-Website (B2B) und Restaurantfinder (B2C)",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run test:e2e",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "astro": "^7.4.13",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "smol-toml": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
